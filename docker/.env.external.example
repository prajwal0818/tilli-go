# ── External Database (Neon / Supabase / other managed PostgreSQL) ──
# Get this from your managed PostgreSQL provider's dashboard.
# Append ?sslmode=require for Neon; use the pooled connection string for Supabase.
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# ── External Redis (Upstash / other managed Redis) ────────────────
# Get these from your Upstash dashboard.
REDIS_HOST=your-endpoint.upstash.io
REDIS_PORT=6379
REDIS_PASSWORD=your-upstash-password

# ── API ──────────────────────────────────────────────────────────
API_PORT=3001
JWT_SECRET=change-me-use-openssl-rand-base64-32
ACK_TOKEN_SECRET=change-me-use-openssl-rand-base64-32
FRONTEND_URL=http://YOUR_SERVER_IP:3000

# ── Frontend ─────────────────────────────────────────────────────
FRONTEND_PORT=3000

# ── SMTP (leave blank for mock/json transport) ───────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ── Email Configuration ─────────────────────────────────────────
EMAIL_DOMAIN=tilli.pro
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=Tilli-go
EMAIL_FALLBACK_TEAM=ops

# ── Microsoft OAuth (optional — leave blank to disable) ─────────
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
MICROSOFT_REDIRECT_URI=
TOKEN_ENCRYPTION_KEY=

# ── Microsoft Graph Email (optional — replaces SMTP) ────────────
MICROSOFT_MAIL_ENABLED=false
MICROSOFT_MAIL_FROM=

# ── Microsoft OAuth on Frontend (optional) ──────────────────────
REACT_APP_MICROSOFT_OAUTH=false
